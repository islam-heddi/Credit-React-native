{
  "expo": {
    "name": "Credit",
    "slug": "Credit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coin-icon.png",
    "scheme": "credit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/coin-icon-foreground.png",
        "monochromeImage": "./assets/images/coin-icon-monochrome.png"
      },
      
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.islam_he.Credit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/coin-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/coin-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e55243fe-d5ac-4ab9-b40c-742de099b274"
      }
    }
  }
}
